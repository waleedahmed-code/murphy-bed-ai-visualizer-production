{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murphy-bed-ai-visualizer-production",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "4201",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://islandmurphybeds.com,https://www.islandmurphybeds.com,https://murphybedplace.com,https://www.murphybedplace.com,https://*.shopifypreview.com"
  }
}
