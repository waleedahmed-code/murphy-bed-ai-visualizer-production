{
  "name": "Murphy Bed Builder",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Murphy Bed"
    },
    {
      "type": "url",
      "id": "room_visualizer_endpoint",
      "label": "AI room visualizer Worker URL",
      "info": "Paste the deployed Cloudflare Worker URL without a trailing slash."
    }
  ],
  "presets": [
    {
      "name": "Murphy Bed Builder"
    }
  ]
}
{% endschema %}
