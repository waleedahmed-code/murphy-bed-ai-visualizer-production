          <div class="builder-progress-title" id="wizard-step-title">Choose Your Size</div>
        </div>
        <div class="builder-progress-total" id="wizard-step-count">Step 1 of 8</div>
      </div>
      <div class="builder-progress-bar">
        <div class="builder-progress-fill" id="wizard-progress-fill"></div>
      </div>
      <div class="wizard-step-dots" id="wizard-step-dots" aria-label="Builder steps"></div>
      <div class="builder-progress-total builder-progress-total--legacy" id="progress-total">0 / 6 customized</div>
    </div>

    <div class="options-container" id="wizard-options-container" data-wizard-options>
      <!-- STEP 1 -->

