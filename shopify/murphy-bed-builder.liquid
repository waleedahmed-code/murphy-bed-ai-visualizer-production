        data-right-wide-sc10-brown-cherry="https://cdn.shopify.com/s/files/1/0698/4836/7174/files/2_0014_BROWN-CHERRY.png?v=1774380988"
        data-right-wide-sc16-arbutus="https://cdn.shopify.com/s/files/1/0698/4836/7174/files/2_0015_ARBUTUS.png?v=1774380988"
        data-right-wide-sidney-spice="https://cdn.shopify.com/s/files/1/0698/4836/7174/files/2_0002_SIDNEY-SPICE_97e47ede-8598-481a-aae3-6360b063371a.png?v=1774380988"
        data-right-wide-garbally-grey="https://cdn.shopify.com/s/files/1/0698/4836/7174/files/2_0010_GARBALLY-GREY.png?v=1774380989"
        data-right-wide-sc23-iron-mountain="https://cdn.shopify.com/s/files/1/0698/4836/7174/files/2_0008_IRON-MOUNTAIN.png?v=1774380988"
        data-right-wide-sc21-cement="https://cdn.shopify.com/s/files/1/0698/4836/7174/files/2_0013_CEMENT.png?v=1774380988"
        data-right-wide-sc13-heritage-brown="https://cdn.shopify.com/s/files/1/0698/4836/7174/files/2_0009_HERITAGE-BROWN.png?v=1774380988"
        data-right-wide-sc4-ebony="https://cdn.shopify.com/s/files/1/0698/4836/7174/files/2_0012_EBONY.png?v=1774380988"
      ></div>
    </div>

    <!-- SUMMARY -->

    <div class="summary-container wizard-summary-container">
      <div class="wizard-live-total">
        <div class="wizard-live-total__copy">
          <span>Configured Total</span>
          <small>Updates instantly as options change</small>
        </div>
        <div class="wizard-live-total__amount">
          <span>CAD</span>
          <strong>$<span id="total-price">2695</span></strong>
        </div>
      </div>

      <div class="wizard-price-breakdown">
        <span>Base <strong>$<span id="base-price">2695</span></strong></span>
        <span>Add-ons <strong>$<span id="addons-price">0</span></strong></span>
      </div>

      <div class="wizard-deposit-summary" aria-live="polite">
        <div class="wizard-deposit-summary__row">
          <span>Full Order Total</span>
          <strong id="deposit-full-order-total">CAD $2,695.00</strong>
        </div>
        <div class="wizard-deposit-summary__row wizard-deposit-summary__row--today">
          <span>Due Today — 50% Deposit</span>
          <strong id="deposit-due-today">CAD $1,347.50</strong>
        </div>
        <div class="wizard-deposit-summary__row">
          <span>Remaining 50% — Due After Professional Installation Service</span>
          <strong id="deposit-remaining">CAD $1,347.50</strong>
        </div>
        <p>Pay 50% today to confirm your Murphy bed order. After professional installation service is completed, our team will contact you to collect the remaining 50%. No automatic second charge will be made.</p>
        <small>Sales Tax is calculated securely by the checkout service and added at checkout.</small>
      </div>

      <div class="wizard-validation-message" id="wizard-validation-message" aria-live="polite"></div>

      <form method="post" action="/cart/add" id="murphy-form">
        <input type="hidden" name="id" id="variant-id" value="{{ murphy_variant_id }}">

        <input type="hidden" name="properties[Size]" id="size-field">
        <input type="hidden" name="properties[Door]" id="door-field">
        <input type="hidden" name="properties[Crown]" id="crown-field">
        <input type="hidden" name="properties[Left Side]" id="left-side-field">
        <input type="hidden" name="properties[Right Side]" id="right-side-field">
        <input type="hidden" name="properties[Finish]" id="finish-field">
        <input type="hidden" name="properties[Color]" id="color-field">
        <input type="hidden" name="properties[Mattress]" id="mattress-field">
        <input type="hidden" name="properties[Lights]" id="lights-field">
        <input type="hidden" name="properties[Face Frame Construction]" id="face-frame-field">
        <input type="hidden" name="properties[Addons Summary]" id="addons-field">
        <input type="hidden" name="properties[Calculated Price]" id="total-price-field" value="">

        <input type="hidden" name="properties[Paint Color Name]" id="paint-color-name-field" value="">
        <input type="hidden" name="properties[Paint Color Code]" id="paint-color-code-field" value="">
        <input type="hidden" name="properties[Paint Source]" id="paint-source-field" value="">

        <input type="hidden" name="properties[Stain Color Name]" id="stain-color-name-field" value="">
        <input type="hidden" name="properties[Stain Color Code]" id="stain-color-code-field" value="">
        <input type="hidden" name="properties[Stain Source]" id="stain-source-field" value="">

        <div class="wizard-navigation">
          <button type="button" class="wizard-nav-button wizard-nav-button--back" id="wizard-back">Back</button>
          <button type="button" class="wizard-nav-button wizard-nav-button--next" id="wizard-next">Next Step -></button>
          <button type="submit" class="btn wizard-checkout-button" id="wizard-checkout" hidden>Pay 50% Deposit</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script type="application/json" id="stain-preview-map">
  {}
</script>
<script src="{{ 'murphy-bed-builder.js' | asset_url }}" defer></script>
<link rel="stylesheet" href="{{ 'murphy-bed-builder.css' | asset_url }}">

