{% assign murphy_product = all_products['murphy-bed-customizable'] %}
{% assign murphy_variant_id = murphy_product.variants.first.id %}

<div
  class="builder-wrapper container"
  data-imb-guided-builder
  data-room-visualizer-endpoint="{{ section.settings.room_visualizer_endpoint | escape }}"
>
  <h1>{{ section.settings.heading }}</h1>

  <!-- LEFT: PREVIEW -->
  <div class="preview-container">
    <div class="preview-toolbar">
      <div class="preview-status">
        <div class="status-pill">
          <span class="label">Size</span>
          <strong id="status-size">Single</strong>
        </div>
        <div class="status-pill">
          <span class="label">Door</span>
          <strong id="status-door">Flat Modern</strong>
        </div>
        <div class="status-pill">
          <span class="label">Finish</span>
          <strong id="status-finish">Light Walnut</strong>
        </div>
      </div>

      <button type="button" class="preview-reset-btn" id="preview-reset">Reset Preview</button>
    </div>

    <div id="preview-stage">
      <img
        id="preview-base"
        src="https://cdn.shopify.com/s/files/1/0759/7955/5038/files/Bed-Section_1.png?v=1758276654"
        alt="Base Bed"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        data-image-default="https://cdn.shopify.com/s/files/1/0759/7955/5038/files/Bed-Section_1.png?v=1758276654"
        data-image-light-walnut="https://cdn.shopify.com/s/files/1/0698/4836/7174/files/LIGHT_WALNUT_49466037-bb94-4eec-9405-90f20c714228.png?v=1773862229"
